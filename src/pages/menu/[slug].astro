---
import '../../styles/global.css';
import PublicMenuIsland from '../../components/react/menu/PublicMenuIsland';
import GlobalToaster from '../../components/react/ui/GlobalToaster';

const { slug } = Astro.params;
---

<!DOCTYPE html>
<html lang="es" class="bg-slate-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Carta Digital Interactiva - brew.cl</title>
    <link rel="icon" type="image/jpeg" href="/images/brew-mascot.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased min-h-screen">
    <PublicMenuIsland client:load />
    <GlobalToaster client:load />
  </body>
</html>
