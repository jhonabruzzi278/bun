---
import '../styles/global.css';
import OnboardingWizardIsland from '../components/react/onboarding/OnboardingWizardIsland';
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-[#F9F6F0] dark:bg-[#170D0B] text-coffee-950 dark:text-[#E8DFD8]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Configura tu Restaurante | Pidelisto</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('bun_theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-full flex flex-col justify-between p-4 sm:p-8 bg-[#F9F6F0] dark:bg-[#170D0B] font-sans antialiased relative overflow-x-hidden transition-colors">
    <!-- Header -->
    <header class="max-w-7xl mx-auto w-full flex items-center justify-between pb-6 border-b border-[#EAE1D6] dark:border-[#3D2420]">
      <a href="/" class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-xl bg-color4 text-white flex items-center justify-center text-base shadow-sm font-bold">
          ☕
        </div>
        <span class="text-xl font-black text-coffee-950 dark:text-white tracking-tight">Pidelisto</span>
      </a>

      <div class="flex items-center gap-3 text-xs text-[#70645A] dark:text-[#A8988B]">
        <span>Asistente de configuración inicial</span>
      </div>
    </header>

    <!-- Main Wizard -->
    <main class="my-auto py-8">
      <OnboardingWizardIsland client:load />
    </main>

    <!-- Footer note -->
    <footer class="text-center text-xs text-[#8C7E73] dark:text-[#70645A] pt-6 border-t border-[#EAE1D6] dark:border-[#3D2420]">
      Pidelisto Platform © {new Date().getFullYear()} • Tu restaurante listo en minutos
    </footer>
  </body>
</html>
