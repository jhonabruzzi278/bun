---
import '../styles/global.css';
import PlatformTenantsIsland from '../components/react/admin/PlatformTenantsIsland';
import { ShieldCheck, Activity, ArrowUpRight, Lock, Sparkles } from 'lucide-react';
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>brew.cl Master Operations | Control Interno de Plataforma</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0A0A0D] text-zinc-100 font-sans antialiased selection:bg-amber-500/30 selection:text-amber-200">
    {/* Background ambient lighting */}
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute -top-40 left-1/4 w-[600px] h-[600px] bg-amber-500/[0.04] rounded-full blur-[120px]"></div>
      <div class="absolute top-1/3 right-10 w-[500px] h-[500px] bg-orange-600/[0.03] rounded-full blur-[140px]"></div>
    </div>

    {/* Master Header */}
    <header class="sticky top-0 z-40 bg-[#0E0E12]/90 backdrop-blur-xl border-b border-white/[0.07] px-4 sm:px-8 py-3.5">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
        {/* Brand & Internal Badge */}
        <div class="flex items-center gap-3">
          <a href="/master" class="flex items-center gap-2.5 group">
            <div class="w-9 h-9 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center font-black text-lg shadow-inner group-hover:scale-105 transition-transform">
              🍺
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-black text-base text-white tracking-tight">brew.cl</span>
                <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-full bg-amber-400/15 text-amber-300 font-bold border border-amber-400/30 tracking-wider">
                  MASTER HQ
                </span>
              </div>
              <p class="text-[10px] text-zinc-400 font-medium">Consola Privada de Gestión SaaS</p>
            </div>
          </a>
        </div>

        {/* Status Indicators & Navigation */}
        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.06] text-xs text-zinc-300 font-mono">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Plataforma Activa</span>
          </div>

          <a
            href="/"
            target="_blank"
            class="hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] text-xs font-bold text-zinc-300 hover:text-white transition"
          >
            <span>Ver Landing</span>
            <ArrowUpRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    </header>

    {/* Master Content */}
    <main class="relative z-10 max-w-7xl mx-auto p-4 sm:p-8">
      <PlatformTenantsIsland client:load />
    </main>
  </body>
</html>
