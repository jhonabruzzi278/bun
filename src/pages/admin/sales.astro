---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { History, Search, Filter, Download, ArrowUpRight, CheckCircle2, Clock } from 'lucide-react';
---

<AdminLayout title="Historial de Pedidos" activePath="/admin/sales">
  <div class="max-w-6xl mx-auto space-y-6 pb-16">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Historial de Pedidos</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Consulta todos los pedidos generados por Web, PDV, QR y Apps de delivery.</p>
      </div>

      <button
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white hover:bg-slate-800 text-xs font-bold transition"
      >
        <Download className="w-4 h-4 text-brand-400" />
        <span>Exportar CSV</span>
      </button>
    </div>

    <!-- Stats summary -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs text-slate-400 font-medium">Ventas Totales Hoy</span>
        <h3 class="text-2xl font-extrabold text-white font-mono">$184.500</h3>
        <span class="text-[10px] text-emerald-400 font-bold">+12% vs ayer</span>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs text-slate-400 font-medium">Pedidos Completados</span>
        <h3 class="text-2xl font-extrabold text-white font-mono">18</h3>
        <span class="text-[10px] text-slate-400">Promedio $10.250 / pedido</span>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs text-slate-400 font-medium">Ticket Promedio</span>
        <h3 class="text-2xl font-extrabold text-white font-mono">$10.250</h3>
        <span class="text-[10px] text-emerald-400 font-bold">Impulso de venta activo</span>
      </div>
    </div>

    <!-- Orders Table -->
    <div class="p-6 rounded-2xl bg-slate-950 border border-slate-800 space-y-4">
      <div class="flex items-center justify-between gap-3">
        <div class="relative flex-1 max-w-sm">
          <Search className="w-4 h-4 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2" />
          <input
            type="text"
            placeholder="Buscar por cliente o #..."
            class="w-full pl-9 pr-3.5 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-brand-500"
          />
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="text-slate-400 border-b border-slate-800 text-[10px] uppercase font-black tracking-wider">
              <th class="py-3 px-3">Pedido</th>
              <th class="py-3 px-3">Canal</th>
              <th class="py-3 px-3">Cliente</th>
              <th class="py-3 px-3">Estado</th>
              <th class="py-3 px-3 text-right">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-850 text-slate-200">
            <tr class="hover:bg-slate-900/50 transition">
              <td class="py-3.5 px-3 font-mono font-bold text-white">#101</td>
              <td class="py-3.5 px-3"><span class="px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 font-bold text-[10px]">WEB</span></td>
              <td class="py-3.5 px-3">Jonathan Guerra</td>
              <td class="py-3.5 px-3"><span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-bold">Entregado</span></td>
              <td class="py-3.5 px-3 text-right font-mono font-bold text-white">$14.500</td>
            </tr>
            <tr class="hover:bg-slate-900/50 transition">
              <td class="py-3.5 px-3 font-mono font-bold text-white">#102</td>
              <td class="py-3.5 px-3"><span class="px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-400 font-bold text-[10px]">PDV</span></td>
              <td class="py-3.5 px-3">Mesa #4</td>
              <td class="py-3.5 px-3"><span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-bold">Entregado</span></td>
              <td class="py-3.5 px-3 text-right font-mono font-bold text-white">$26.000</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
