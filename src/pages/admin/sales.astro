---
import AdminLayout from '../../layouts/AdminLayout.astro';
import OrdersWithAiInsightsIsland from '../../components/react/orders/OrdersWithAiInsightsIsland';
---

<AdminLayout title="Órdenes y Pedidos" activePath="/admin/sales">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-coffee-950 tracking-tight">
          Gestión de Órdenes
        </h1>
        <p class="text-xs sm:text-sm text-[#70645A] mt-1">
          Visualiza los pedidos en tiempo real con recomendaciones automatizadas por Inteligencia Artificial.
        </p>
      </div>
    </div>

    <!-- Orders Table + AI Insights Component -->
    <OrdersWithAiInsightsIsland client:load />
  </div>
</AdminLayout>
