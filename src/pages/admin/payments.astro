---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { CreditCard, CheckCircle2, ShieldCheck } from 'lucide-react';
---

<AdminLayout title="Métodos de Pago" activePath="/admin/payments">
  <div class="max-w-4xl mx-auto space-y-6 pb-12">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-coffee-950 dark:text-white tracking-tight">
        Métodos de Pago
      </h1>
      <p class="text-xs sm:text-sm text-[#70645A] dark:text-[#A8988B] mt-1">
        Configura las formas de cobro disponibles en tu menú digital y punto de venta.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-5 rounded-2xl bg-white dark:bg-[#241512] border border-[#EAE1D6] dark:border-[#3D2420] shadow-coffee-sm space-y-3 transition-colors">
        <div className="flex items-center justify-between">
          <span class="text-xs font-bold text-coffee-950 dark:text-white">Efectivo en Salón</span>
          <span class="text-[10px] font-bold text-[#2E7D32] dark:text-[#4ADE80] bg-[#E7F3E8] dark:bg-[#1A3320] px-2 py-0.5 rounded-full border border-[#D0EBD2] dark:border-[#2C5935]">Activo</span>
        </div>
        <p class="text-xs text-[#70645A] dark:text-[#A8988B]">Tus clientes pagan al recibir o retirar su pedido en efectivo.</p>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-[#241512] border border-[#EAE1D6] dark:border-[#3D2420] shadow-coffee-sm space-y-3 transition-colors">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-coffee-950 dark:text-white">Transferencia Bancaria</span>
          <span class="text-[10px] font-bold text-[#2E7D32] dark:text-[#4ADE80] bg-[#E7F3E8] dark:bg-[#1A3320] px-2 py-0.5 rounded-full border border-[#D0EBD2] dark:border-[#2C5935]">Activo</span>
        </div>
        <p class="text-xs text-[#70645A] dark:text-[#A8988B]">Muestra los datos bancarios y solicita comprobante por WhatsApp.</p>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-[#241512] border border-[#EAE1D6] dark:border-[#3D2420] shadow-coffee-sm space-y-3 transition-colors">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-coffee-950 dark:text-white">Webpay / MercadoPago</span>
          <span class="text-[10px] font-bold text-[#A0740E] dark:text-[#FBBF24] bg-[#FEF8E3] dark:bg-[#33220E] px-2 py-0.5 rounded-full border border-[#FDECB8] dark:border-[#593E1A]">Enlace Activo</span>
        </div>
        <p class="text-xs text-[#70645A] dark:text-[#A8988B]">Acepta tarjetas de crédito/débito con Webpay Plus, Mercado Pago o Stripe.</p>
      </div>
    </div>
  </div>
</AdminLayout>
