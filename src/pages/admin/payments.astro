---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { CreditCard, CheckCircle2, ShieldCheck, ArrowRight } from 'lucide-react';
---

<AdminLayout title="Métodos de Pago" activePath="/admin/payments">
  <div class="max-w-4xl mx-auto space-y-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Métodos de Pago</h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">Configura las formas de cobro disponibles en tu menú digital y punto de venta.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-white">Efectivo</span>
          <span class="text-[10px] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full">Activo</span>
        </div>
        <p class="text-xs text-slate-400">Tus clientes pagan al recibir o retirar su pedido en efectivo.</p>
      </div>

      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-white">Transferencia Bancaria</span>
          <span class="text-[10px] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full">Activo</span>
        </div>
        <p class="text-xs text-slate-400">Muestra los datos bancarios y solicita comprobante por WhatsApp.</p>
      </div>

      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-white">Link de Pago / Tarjetas</span>
          <span class="text-[10px] font-bold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full">Configurar</span>
        </div>
        <p class="text-xs text-slate-400">Acepta tarjetas de crédito/débito con Webpay, MercadoPago o Stripe.</p>
      </div>
    </div>
  </div>
</AdminLayout>
