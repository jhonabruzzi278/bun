---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Lock, Unlock, DollarSign, CheckCircle2 } from 'lucide-react';
---

<AdminLayout title="Cuadre y Arqueo de Cajas" activePath="/admin/cashier">
  <div class="max-w-6xl mx-auto space-y-6 pb-16">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-coffee-950 dark:text-white tracking-tight">
          Cajas y Cuadre de Turnos
        </h1>
        <p class="text-xs sm:text-sm text-[#70645A] dark:text-[#A8988B] mt-1">
          Apertura de turno, control de efectivo inicial y arqueo de caja diario.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-color4 hover:bg-[#522B2B] text-white font-bold text-xs shadow-coffee-sm transition"
        >
          <Lock className="w-4 h-4" />
          <span>Cerrar Turno Actual</span>
        </button>
      </div>
    </div>

    <!-- Active Cashier Card -->
    <div class="p-6 rounded-3xl bg-white dark:bg-[#241512] border border-[#EAE1D6] dark:border-[#3D2420] shadow-coffee-sm space-y-6 transition-colors">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#F4EFEA] dark:border-[#331C18]">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-2xl bg-[#E7F3E8] dark:bg-[#1A3320] text-[#2E7D32] dark:text-[#4ADE80] flex items-center justify-center border border-[#D0EBD2] dark:border-[#2C5935]">
            <Unlock className="w-6 h-6" />
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-base font-bold text-coffee-950 dark:text-white">Caja Principal #1 (Turno Tarde)</h3>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-[#E7F3E8] dark:bg-[#1A3320] text-[#2E7D32] dark:text-[#4ADE80] border border-[#D0EBD2] dark:border-[#2C5935]">
                Abierta
              </span>
            </div>
            <p class="text-xs text-[#70645A] dark:text-[#A8988B] mt-0.5">Operador: Jonathan Guerra • Apertura: Hoy 14:00 hrs</p>
          </div>
        </div>

        <div class="text-right">
          <span class="text-xs text-[#70645A] dark:text-[#A8988B] block font-medium">Efectivo en Caja Esperado</span>
          <span class="text-2xl font-black text-coffee-950 dark:text-white font-mono">$134.500</span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
        <div class="p-4 rounded-2xl bg-[#FAF7F2] dark:bg-[#180E0C] border border-[#EAE1D6] dark:border-[#3D2420]">
          <span class="text-[11px] text-[#70645A] dark:text-[#A8988B] block font-semibold">Monto Inicial</span>
          <span class="text-base font-bold text-coffee-950 dark:text-white font-mono mt-1 block">$50.000</span>
        </div>
        <div class="p-4 rounded-2xl bg-[#FAF7F2] dark:bg-[#180E0C] border border-[#EAE1D6] dark:border-[#3D2420]">
          <span class="text-[11px] text-[#70645A] dark:text-[#A8988B] block font-semibold">Ventas Efectivo</span>
          <span class="text-base font-bold text-[#2E7D32] dark:text-[#4ADE80] font-mono mt-1 block">+$84.500</span>
        </div>
        <div class="p-4 rounded-2xl bg-[#FAF7F2] dark:bg-[#180E0C] border border-[#EAE1D6] dark:border-[#3D2420]">
          <span class="text-[11px] text-[#70645A] dark:text-[#A8988B] block font-semibold">Ventas Tarjeta / Link</span>
          <span class="text-base font-bold text-color4 dark:text-color2 font-mono mt-1 block">$100.000</span>
        </div>
        <div class="p-4 rounded-2xl bg-[#FAF7F2] dark:bg-[#180E0C] border border-[#EAE1D6] dark:border-[#3D2420]">
          <span class="text-[11px] text-[#70645A] dark:text-[#A8988B] block font-semibold">Retiros / Gastos</span>
          <span class="text-base font-bold text-rose-500 font-mono mt-1 block">$0</span>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
