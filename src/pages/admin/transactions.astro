---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { DollarSign, ArrowDownRight, ArrowUpRight, Plus, Download, CreditCard, Banknote } from 'lucide-react';
---

<AdminLayout title="Registros Financieros" activePath="/admin/transactions">
  <div class="max-w-6xl mx-auto space-y-6 pb-16">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Registros Financieros</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Control de ingresos, egresos, propinas acumuladas y comisiones.</p>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-bold text-xs shadow-lg transition"
        >
          <Plus className="w-4 h-4" />
          <span>Registrar Movimiento</span>
        </button>
      </div>
    </div>

    <!-- Summary cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs text-slate-400 font-medium">Ingresos Totales (Mes)</span>
        <h3 class="text-2xl font-extrabold text-emerald-400 font-mono">$2.300.000</h3>
        <span class="text-[10px] text-slate-400">Bruto cobrado</span>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs text-slate-400 font-medium">Propinas Acumuladas</span>
        <h3 class="text-2xl font-extrabold text-amber-400 font-mono">$115.000</h3>
        <span class="text-[10px] text-slate-400">Por repartir al equipo</span>
      </div>
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-1">
        <span class="text-xs text-slate-400 font-medium">Tarifas de Delivery</span>
        <h3 class="text-2xl font-extrabold text-blue-400 font-mono">$84.500</h3>
        <span class="text-[10px] text-slate-400">Cobros por envío</span>
      </div>
    </div>
  </div>
</AdminLayout>
