---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Printer } from 'lucide-react';
---

<AdminLayout title="Impresoras y Tickets" activePath="/admin/printers">
  <div class="max-w-4xl mx-auto space-y-6 pb-12">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-coffee-950 dark:text-white tracking-tight">
        Impresoras y Tickets
      </h1>
      <p class="text-xs sm:text-sm text-[#70645A] dark:text-[#A8988B] mt-1">
        Conecta impresoras térmicas ESC/POS (58mm / 80mm) para tickets de cocina y comandas.
      </p>
    </div>

    <div class="p-6 rounded-2xl bg-white dark:bg-[#241512] border border-[#EAE1D6] dark:border-[#3D2420] shadow-coffee-sm space-y-4 transition-colors">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#FAF7F2] dark:bg-[#180E0C] border border-[#EAE1D6] dark:border-[#3D2420] flex items-center justify-center text-color4 dark:text-color2">
            <Printer className="w-5 h-5" />
          </div>
          <div>
            <h4 class="text-sm font-bold text-coffee-950 dark:text-white">Impresora de Cocina (Comandas)</h4>
            <span class="text-xs text-[#70645A] dark:text-[#A8988B]">Térmica 80mm • USB / Red Local</span>
          </div>
        </div>

        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#FEF8E3] dark:bg-[#33220E] text-[#A0740E] dark:text-[#FBBF24] border border-[#FDECB8] dark:border-[#593E1A]">
          En configuración
        </span>
      </div>
    </div>
  </div>
</AdminLayout>
