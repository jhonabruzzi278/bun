---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ThermalPrinterSimulatorIsland from '../../components/react/printers/ThermalPrinterSimulatorIsland';
---

<AdminLayout title="Impresoras Térmicas ESC/POS" activePath="/admin/printers">
  <div class="max-w-6xl mx-auto space-y-6 pb-16">
    <div>
      <div class="flex items-center gap-2 text-xs font-bold text-amber-500 uppercase tracking-widest">
        <span>Hardware & Periféricos</span>
        <span>•</span>
        <span>Simulador ESC/POS</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-coffee-950 dark:text-white tracking-tight mt-1">
        Impresoras Térmicas & Tickets
      </h1>
      <p class="text-xs sm:text-sm text-[#70645A] dark:text-[#A8988B] mt-1">
        Control y simulación de comanderas de cocina (80mm), barra (58mm) y pre-cuenta de cliente con corte automático.
      </p>
    </div>

    <!-- Interactive Simulator Island -->
    <ThermalPrinterSimulatorIsland client:load />
  </div>
</AdminLayout>
