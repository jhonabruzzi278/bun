---
export const prerender = true;

import '../styles/global.css';
import LandingNavbar from '../components/react/landing/LandingNavbar';
import LandingHero from '../components/react/landing/LandingHero';
import LandingFeatures from '../components/react/landing/LandingFeatures';
import LandingPricing from '../components/react/landing/LandingPricing';
import LandingFAQ from '../components/react/landing/LandingFAQ';
import LandingFooter from '../components/react/landing/LandingFooter';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth bg-[#09090B] text-zinc-100 selection:bg-amber-500 selection:text-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>brew.cl — Plataforma Operativa para la Gastronomía y Cervecerías</title>
    <meta
      name="description"
      content="brew.cl es la plataforma integral para restaurantes, bares y cervecerías modernas: Menú Digital QR ultrarrápido, Cocina KDS en vivo, Punto de Venta (POS) con lector de códigos de barras, simulación térmica ESC/POS y gestión analítica."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#09090B] font-sans antialiased overflow-x-hidden text-zinc-100 relative min-h-screen">
    {/* Clerk-Style Ambient Glow Background */}
    <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
      <div class="absolute -top-[20%] left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-gradient-to-b from-amber-500/10 via-amber-600/5 to-transparent blur-[140px] rounded-full" />
      <div class="absolute top-[40%] right-[-10%] w-[500px] h-[500px] bg-amber-500/[0.04] blur-[150px] rounded-full" />
      <div class="absolute top-[70%] left-[-10%] w-[600px] h-[600px] bg-amber-600/[0.03] blur-[160px] rounded-full" />
      <div 
        class="absolute inset-0 opacity-[0.025] pointer-events-none"
        style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 28px 28px;"
      />
    </div>

    <div class="relative z-10">
      <LandingNavbar client:load />
      <main>
        <LandingHero client:load />
        <LandingFeatures client:load />
        <LandingPricing client:load />
        <LandingFAQ client:load />
      </main>
      <LandingFooter client:load />
    </div>
  </body>
</html>
