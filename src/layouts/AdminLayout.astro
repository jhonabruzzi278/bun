---
import '../styles/global.css';

interface Props {
  title?: string;
  activePath?: string;
}

const { title = 'Admin - BUN', activePath = '/admin' } = Astro.props;

const navItems = [
  { label: 'Dashboard', href: '/admin', icon: 'LayoutDashboard' },
  { label: 'Mi Negocio', href: '/admin/business', icon: 'Store' },
  { label: 'Categorías', href: '/admin/categories', icon: 'FolderKanban' },
  { label: 'Productos', href: '/admin/products', icon: 'UtensilsCrossed' },
  { label: 'Vista Previa Móvil', href: '/admin/preview', icon: 'Smartphone' },
];
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="h-full flex overflow-hidden text-slate-100 font-sans">
    
    <!-- Sidebar -->
    <aside class="w-64 bg-slate-950 border-r border-slate-800 flex flex-col justify-between shrink-0 hidden md:flex">
      <div>
        <!-- Logo -->
        <div class="h-16 px-6 flex items-center gap-3 border-b border-slate-800/80">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 to-brand-400 flex items-center justify-center font-black text-white shadow-lg shadow-brand-500/30 text-lg">
            🍔
          </div>
          <div>
            <span class="font-extrabold text-lg tracking-tight text-white">BUN</span>
            <span class="text-[10px] uppercase font-bold tracking-widest bg-brand-500/20 text-brand-400 px-1.5 py-0.5 rounded ml-1.5">OlaClick style</span>
          </div>
        </div>

        <!-- Business Mini Card -->
        <div class="p-4 mx-3 my-3 rounded-xl bg-slate-900/90 border border-slate-800 flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-slate-800 flex items-center justify-center text-xl overflow-hidden">
            🥩
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-sm font-semibold text-white truncate">Burger Craft & Co.</h4>
            <span class="inline-flex items-center gap-1.5 text-[11px] text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Abierto • En línea
            </span>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="px-3 space-y-1 mt-2">
          {navItems.map((item) => {
            const isActive = activePath === item.href;
            return (
              <a
                href={item.href}
                class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all ${
                  isActive
                    ? 'bg-brand-500 text-white font-semibold shadow-md shadow-brand-500/20'
                    : 'text-slate-400 hover:text-slate-100 hover:bg-slate-900'
                }`}
              >
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>
      </div>

      <!-- Bottom Links -->
      <div class="p-4 border-t border-slate-800/80 space-y-2">
        <a
          href="/menu/burger-craft"
          target="_blank"
          class="flex items-center justify-center gap-2 w-full py-2.5 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 text-xs font-semibold border border-slate-700 transition"
        >
          <span>Ver Menú Público</span>
          <span class="text-xs">↗</span>
        </a>
        <div class="flex items-center justify-between text-xs text-slate-500 px-1 pt-1">
          <span>Tenant: <strong class="text-slate-400 font-mono">tenant_001</strong></span>
          <span class="text-[10px] bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded">v0.1.0</span>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 bg-slate-900 overflow-y-auto">
      <!-- Topbar Mobile & Breadcrumbs -->
      <header class="h-16 border-b border-slate-800 px-6 flex items-center justify-between bg-slate-950/50 backdrop-blur sticky top-0 z-20">
        <div class="flex items-center gap-4">
          <div class="md:hidden flex items-center gap-2">
            <span class="text-xl">🍔</span>
            <span class="font-bold text-white">BUN</span>
          </div>
          <span class="hidden md:inline-block text-xs font-medium text-slate-400">
            Panel de Control &gt; <span class="text-slate-200 font-semibold">{title}</span>
          </span>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/admin/preview"
            class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-brand-500/10 text-brand-400 hover:bg-brand-500/20 text-xs font-medium border border-brand-500/30 transition"
          >
            📱 Vista Previa Móvil
          </a>
          <a
            href="/menu/burger-craft"
            target="_blank"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-brand-500 text-white hover:bg-brand-600 text-xs font-semibold shadow-sm transition"
          >
            Abrir Menú ↗
          </a>
        </div>
      </header>

      <!-- Page Content -->
      <main class="flex-1 p-6 max-w-7xl w-full mx-auto">
        <slot />
      </main>
    </div>

  </body>
</html>
