---
import '../styles/global.css';
import AdminSidebarNav from '../components/react/layout/AdminSidebarNav';
import SystemStatusWidget from '../components/react/ui/SystemStatusWidget';
import TopHeaderBar from '../components/react/ui/TopHeaderBar';

interface Props {
  title?: string;
  activePath?: string;
}

const { title = 'Panel de Administración', activePath = '/admin' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - BUN / Maestro Cervecero</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Theme Auto-Init Script -->
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('bun_theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="h-full flex overflow-hidden text-coffee-950 dark:text-[#F5EFE8] font-sans bg-[#F9F6F0] dark:bg-[#170D0B] transition-colors duration-200">
    
    <!-- Sidebar -->
    <aside class="w-64 bg-[#FAF7F2] dark:bg-[#1F1210] border-r border-[#ECE4DA] dark:border-[#3D2420] flex flex-col justify-between shrink-0 hidden md:flex z-30 transition-colors">
      <div class="overflow-y-auto">
        <!-- Logo & Header -->
        <div class="h-20 px-5 flex items-center gap-3 border-b border-[#ECE4DA] dark:border-[#3D2420]">
          <div class="w-10 h-10 rounded-full bg-color5 dark:bg-[#381C1C] text-white flex items-center justify-center text-lg shadow-sm shrink-0 border-2 border-white dark:border-[#4D2B24]">
            ☕
          </div>
          <div class="min-w-0">
            <h3 class="font-extrabold text-sm tracking-tight text-coffee-950 dark:text-white truncate leading-tight">
              Maestro cervecero
            </h3>
            <p class="text-[10px] text-[#8C7E73] dark:text-[#A8988B] font-medium truncate">
              Panel de administración
            </p>
          </div>
        </div>

        <!-- Navigation Menu -->
        <AdminSidebarNav client:load activePath={activePath} />
      </div>

      <!-- Bottom System Status -->
      <div>
        <SystemStatusWidget client:load />
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 bg-[#F9F6F0] dark:bg-[#170D0B] overflow-y-auto transition-colors">
      <!-- Topbar Header -->
      <TopHeaderBar client:load />

      <!-- Page Content -->
      <main class="flex-1 p-4 md:p-8 max-w-7xl w-full mx-auto">
        <slot />
      </main>
    </div>

  </body>
</html>
